<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Editor workspace · Kabita Live</title><link rel="stylesheet" href="assets/editor-workspace.css"><script type="module" src="assets/editor-workspace.mjs"></script></head><body>
<a class="skip" href="#canvas">Skip to page editor</a><header><a class="brand" href="index.html">Kabita Live</a><span>Edition studio</span><span class="badge">Private edition workspace</span></header>
<div class="topbar"><div><strong id="issue-label">November 2026 · Issue 49</strong><small id="edition-state">Sign in to prepare your edition</small><small id="save-state" hidden></small></div></div>
<section class="shared" id="signin-panel"><h1>Your monthly edition</h1><p>Sign in to open your prepared edition. Add poems or articles, arrange them, preview, then send for review.</p><button type="button" id="cloud-login" disabled>Sign in with Google</button></section><p id="cloud-status" class="account-status" role="status" tabindex="-1">Checking shared workspace availability…</p>
<section class="shared" id="management" hidden><details><summary id="shared-heading">More options</summary><div class="actions"><label class="open">Restore a backup<input id="open" type="file" accept=".json,application/json"></label><button id="download">Download backup</button><button id="cloud-logout" type="button" hidden>Sign out</button></div><div id="cloud-controls" hidden><form method="post" action="#" id="cloud-month-form"><label for="cloud-month">Open another month · YYYY-MM</label><input id="cloud-month" name="month" value="2026-11" pattern="20[0-9]{2}-(0[1-9]|1[0-2])" maxlength="7" required><button type="submit" id="cloud-open">Open edition</button></form><div class="actions"><button type="button" id="cloud-save">Save now</button><button type="button" id="cloud-import">Add selected submissions</button><button type="button" id="cloud-history">View saved history</button><button type="button" id="recover-copies">Recover an unfinished copy</button></div><ul id="cloud-revisions"></ul><div id="recovery-list"></div></div><details class="handoff"><summary>Production tools</summary><ul id="blockers"></ul><button id="handoff">Download production package</button><p>Production checks and Ahimanikya’s website approval follow editorial review.</p></details></details></section>
<section id="reconcile" class="shared" hidden tabindex="-1" aria-labelledby="reconcile-heading"><h2 id="reconcile-heading">Choose which edition to continue</h2><p>Another version is available. Compare both below. Both copies will be kept in this browser session under More options. The latest shared version also remains in saved history. Choosing your copy replaces the current shared edition after saving.</p><div class="comparison"><div><label for="my-copy">My unfinished edition</label><textarea id="my-copy" readonly></textarea><button id="choose-mine">Continue with my edition</button></div><div><label for="shared-copy">Latest saved edition</label><textarea id="shared-copy" readonly></textarea><button id="choose-shared">Continue with latest saved edition</button></div></div></section>
<section id="import-preview" class="shared" hidden aria-labelledby="import-heading"><h2 id="import-heading">Review imported article</h2><p id="import-warning"></p><label for="import-text">Imported text · read-only preview</label><textarea id="import-text" name="importPreview" readonly></textarea><div class="actions"><button id="import-confirm" type="button">Add article to edition</button><button id="import-cancel" type="button">Cancel import</button></div></section>
<div class="studio" id="studio" hidden><aside class="pages"><h1>Your edition</h1><details class="add-content"><summary>Add content</summary><label class="open">Upload Word or text<input id="article-import" name="articleFile" type="file" accept=".docx,.txt"></label><button id="add">Write a poem</button><button id="add-article">Write an article</button></details><nav id="pages" aria-label="Edition pages"></nav></aside>
<main data-pagefind-ignore="all" id="canvas" tabindex="-1"><div class="canvas-tools"><div class="actions" role="group" aria-label="Editing mode"><button id="edit-mode" aria-pressed="true">Edit</button><button id="preview-mode" aria-pressed="false">Preview whole edition</button></div><div class="actions"><button id="undo" disabled>Undo</button><button id="width" aria-pressed="false" hidden>Phone width</button></div></div><p id="mode-help"></p><p id="notice" role="status" tabindex="-1"></p><div id="paper" class="paper"></div><div class="page-footer"><span id="page-name"></span><span>Reading proof · final publication layout may differ</span></div></main>
<aside class="properties"><h2 id="properties-heading">Issue details</h2><div id="properties"></div></aside></div>
<form id="submit-review" method="post" action="#"></form><div class="device-actions" id="edition-actions" hidden aria-label="Edition actions"><span id="device-save-state" role="status">Opening edition…</span><button id="device-save" type="button" hidden>Try saving again</button><button type="submit" form="submit-review" class="primary">Send edition for review</button></div><noscript>This private editor requires JavaScript. No draft is submitted from this page.</noscript></body></html>