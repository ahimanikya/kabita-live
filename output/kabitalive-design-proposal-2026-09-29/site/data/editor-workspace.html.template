nagement" hidden><details hidden><summary id="shared-heading">Internal draft tools</summary><p><a href="editor-management.html" target="_blank" rel="noopener" aria-label="Comments &amp; statistics (new tab)" title="Opens in a new tab">Comments &amp; statistics <span aria-hidden="true">↗</span></a></p><div class="actions"><label class="open">Restore a backup<input id="open" type="file" accept=".json,application/json"></label><button id="download">Download backup</button></div><div id="cloud-controls" hidden><form method="post" action="#" id="cloud-month-form"><label for="cloud-month">Open another month · YYYY-MM</label><input id="cloud-month" name="month" value="2026-11" pattern="20[0-9]{2}-(0[1-9]|1[0-2])" maxlength="7" required><button type="submit" id="cloud-open">Open edition</button></form><div class="actions"><button type="button" id="cloud-save">Save now</button><button type="button" id="cloud-import">Add selected submissions</button><button type="button" id="cloud-history">View saved history</button><button type="button" id="recover-copies">Recover an unfinished copy</button></div><ul id="cloud-revisions"></ul><div id="recovery-list"></div></div><details class="handoff"><summary>Production tools</summary><ul id="blockers"></ul><button id="handoff">Download production package</button><p>Production checks and Ahimanikya’s website approval follow editorial review.</p></details></details></section></div><div id="sidebar-account" class="sidebar-account" hidden><img id="account-photo" width="40" height="40" alt="" referrerpolicy="no-referrer" hidden><span id="account-initials" aria-hidden="true"></span><span id="account-name"></span></div></aside>
<main data-pagefind-ignore="all" id="canvas" tabindex="-1"><div class="canvas-tools"><div class="actions" role="group" aria-label="Editing mode"><button id="edit-mode" aria-pressed="true">Edit</button><button id="preview-mode" aria-pressed="false">Preview whole edition</button></div><div class="actions"><button id="undo" disabled>Undo</button><button id="width" aria-pressed="false" hidden>Phone width</button></div></div><p id="mode-help"></p><p id="notice" role="status" tabindex="-1"></p><section class="shared" id="submission-desks" hidden><div id="submission-overview"><h2>Pending Submissions</h2><section id="monthly-inbox" aria-label="Kabita Live submissions"><p id="monthly-inbox-status" role="status"></p><div class="article-table-wrap" tabindex="0" role="region" aria-label="Pending submissions"><table class="article-table submission-table"><thead><tr><th scope="col">Title</th><th scope="col">Author</th><th scope="col">Language</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead><tbody id="monthly-inbox-list"></tbody></table></div><div class="actions"><button id="monthly-inbox-refresh" type="button">Refresh</button><button id="monthly-inbox-more" type="button" hidden>Show more</button><a href="monthly-review.html" target="_blank" rel="noopener">Review desk ↗</a></div></section><section id="anthology-inbox" aria-label="Toshali Anthology submissions" hidden><p id="anthology-inbox-status" role="status"></p><div class="article-table-wrap" tabindex="0" role="region" aria-label="Pending submissions"><table class="article-table submission-table"><thead><tr><th scope="col">Title</th><th scope="col">Author</th><th scope="col">Language</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead><tbody id="anthology-inbox-list"></tbody></table></div><div class="actions"><button id="anthology-inbox-refresh" type="button">Refresh</button><button id="anthology-inbox-more" type="button" hidden>Show more</button><a href="toshali-review.html" target="_blank" rel="noopener">Review desk ↗</a></div></section></div></section><div id="paper" class="paper"></div><div class="page-footer"><span id="page-name"></span><span>Reading proof · final publication layout may differ</span></div></main>
