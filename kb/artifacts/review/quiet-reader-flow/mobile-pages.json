    "lines": [
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "23",
        "lang": "en",
        "sourceLine": "0",
        "text": " Though gives a shelter to others"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "24",
        "lang": "en",
        "sourceLine": "0",
        "text": " Like a wandering bird"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "25",
        "lang": "en",
        "sourceLine": "0",
        "text": " He finds a little space"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "26",
        "lang": "en",
        "sourceLine": "0",
        "text": " in the impervious cave"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "27",
        "lang": "en",
        "sourceLine": "0",
        "text": " Of his own heart"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "28",
        "lang": "en",
        "sourceLine": "0",
        "text": " Just for himself.."
      }
    ],
