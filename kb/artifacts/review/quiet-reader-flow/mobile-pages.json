    "lines": [
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "0",
        "lang": "or",
        "sourceLine": "0",
        "text": "ଅଟ୍ଟାଳିକା ହୁଏ ଯେତେ ଉଚ୍ଚତର"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "1",
        "lang": "or",
        "sourceLine": "1",
        "text": "ସେଡିକି ଗଭୀର ତା ଭିତ୍ତିପ୍ରସ୍ତର"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "2",
        "lang": "or",
        "sourceLine": "2",
        "text": "ଉପରେ ହେଉ ସେ ଯେତିକି ସୁନ୍ଦର"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "3",
        "lang": "or",
        "sourceLine": "3",
        "text": "ମୂଳେ ତାର ମାଟି କାଦୁଅ ପଥର"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "4",
        "lang": "or",
        "sourceLine": "4",
        "text": "ଅଟ୍ଟାଳିକା ଅଟେ ଯେଡ଼େ ପ୍ରସାରିତ"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "5",
        "lang": "or",
        "sourceLine": "5",
        "text": "ଯନ୍ତ୍ରଣାର ମୂଳ ସେତେ ବିସ୍ତାରିତ"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "6",
        "lang": "or",
        "sourceLine": "6",
        "text": "ବୟସରେ ଯେବେ ଆସେ ଅପରାହ୍ନ"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "7",
        "lang": "or",
        "sourceLine": "7",
        "text": "କେତେ ରାତି, ଉଷା କୋମଳ ସ୍ବପନ"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "8",
        "lang": "or",
        "sourceLine": "8",
        "text": "ନିଏ ଯେ ଆହୁତି ହୁଏ ଖିନ୍ନ ଭିନ୍ନ"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "9",
        "lang": "or",
        "sourceLine": "9",
        "text": "ଜଳି ପ୍ରଜ୍ବଳିତ ଯେସନେ ସୁବର୍ଣ୍ଣ"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "10",
        "lang": "or",
        "sourceLine": "10",
        "text": "ପ୍ରକୃତିରେ ହିଆ ହୁଏ ବଳିଆନ"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "11",
        "lang": "or",
        "sourceLine": "11",
        "text": "ଯଦି ରଖେ ଅନ୍ୟ ମନ ଆଉ ମାନ"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "12",
        "lang": "or",
        "sourceLine": "12",
        "text": "ଅନ୍ୟେ ଦେଇ ଆଶ୍ରା ଅଟ୍ଟାଳିକା ପରି"
      }
    ],
    "nextDisabled": false,
    "overflow": false,
    "progress": "1 / 4 · Poem 1 / 2",
    "titles": [
      {
        "id": "8",
        "title": "ନିବିଡ ହୃଦୟ ନୀଡManorama Choudhury"
      }
    ]
  },
  {
    "ids": [
      "8",
      "9"
    ],
    "lines": [
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "13",
        "lang": "or",
        "sourceLine": "13",
        "text": "ଛିଡା ଯେ ମନୁଷ୍ୟ ରହେ ଦମ୍ଭ ଧରି"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "14",
        "lang": "or",
        "sourceLine": "14",
        "text": "ସ୍ନେହ, ଶ୍ରଦ୍ଧା, ପ୍ରେମ କାଉଁରୀ ବିସ୍ତାରି"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "15",
        "lang": "or",
        "sourceLine": "15",
        "text": "ପିଇଯାଏ କୋହ ଲୁହର ଲହରୀ"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "16",
        "lang": "or",
        "sourceLine": "16",
        "text": "ସମୟର ତାଳେ ମାପକାଠି ପରି"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "17",
        "lang": "or",
        "sourceLine": "17",
        "text": "ଜଳାଧାର ପ୍ରାୟେ ବହେ ଥିରି ଥିରି"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "18",
        "lang": "or",
        "sourceLine": "18",
        "text": "ବାଁଆଁରା ଚଢେଇ ଖୋଜି ନିଜ ନୀଡ"
      },
      {
        "font": "\"Noto Serif Oriya\", serif",
        "id": "8",
        "index": "19",
        "lang": "or",
        "sourceLine": "19",
        "text": "ହଜେ ଆଲିଙ୍ଗନେ ତାହାର ନିବିଡ |"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "0",
        "lang": "en",
        "sourceLine": "0",
        "text": "Taller the building"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "1",
        "lang": "en",
        "sourceLine": "0",
        "text": " Deeper its foundation"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "2",
        "lang": "en",
        "sourceLine": "0",
        "text": " Prettier the outer layer"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "3",
        "lang": "en",
        "sourceLine": "0",
        "text": " Muddier the root structure"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "4",
        "lang": "en",
        "sourceLine": "0",
        "text": " Wider the building’s perimeter"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "5",
        "lang": "en",
        "sourceLine": "0",
        "text": " Complex the root architecture"
      }
    ],
    "nextDisabled": false,
    "overflow": false,
    "progress": "2 / 4 · Poems 1–2 / 2",
    "titles": [
      {
        "id": "9",
        "title": "Heart, the impervious cave..Manorama Choudhury"
      }
    ]
  },
  {
    "ids": [
      "9"
    ],
    "lines": [
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "6",
        "lang": "en",
        "sourceLine": "0",
        "text": " As life inches towards its afternoon"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "7",
        "lang": "en",
        "sourceLine": "0",
        "text": " Dreams and desires"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "8",
        "lang": "en",
        "sourceLine": "0",
        "text": " Scattered and sacrificed"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "9",
        "lang": "en",
        "sourceLine": "0",
        "text": " Deduced to thin air"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "10",
        "lang": "en",
        "sourceLine": "0",
        "text": " Even after, the heart that holds"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "11",
        "lang": "en",
        "sourceLine": "0",
        "text": " Respect and love for others"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "12",
        "lang": "en",
        "sourceLine": "0",
        "text": " Sparkles like gold"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "13",
        "lang": "en",
        "sourceLine": "0",
        "text": " Though burnt with fire."
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "14",
        "lang": "en",
        "sourceLine": "0",
        "text": " Just like the building"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "15",
        "lang": "en",
        "sourceLine": "0",
        "text": " Gives shelter to many"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "16",
        "lang": "en",
        "sourceLine": "0",
        "text": " And stands tall"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "17",
        "lang": "en",
        "sourceLine": "0",
        "text": " The man who supports others"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "18",
        "lang": "en",
        "sourceLine": "0",
        "text": " Despite his pain, he smiles"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "19",
        "lang": "en",
        "sourceLine": "0",
        "text": " And spreads love and affection"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "20",
        "lang": "en",
        "sourceLine": "0",
        "text": " To one and all"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "21",
        "lang": "en",
        "sourceLine": "0",
        "text": " He turns to an ever-flowing river,"
      },
      {
        "font": "\"Source Serif 4\", Georgia, \"Noto Serif Oriya\", \"Tiro Devanagari Hindi\", serif",
        "id": "9",
        "index": "22",
        "lang": "en",
        "sourceLine": "0",
        "text": " Withstands the test of time after all."
      }
    ],
    "nextDisabled": false,
    "overflow": false,
    "progress": "3 / 4 · Poem 2 / 2",
