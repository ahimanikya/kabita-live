          "lines": [
            {
              "lang": "en",
              "line": 0,
              "poem": "831",
              "start": 0,
              "text": "I was fierce when I was young,"
            },
            {
              "lang": "en",
              "line": 1,
              "poem": "831",
              "start": 0,
              "text": "I would lose my temper over little things."
            },
            {
              "lang": "en",
              "line": 2,
              "poem": "831",
              "start": 0,
              "text": "I was strongly built, too,"
            },
            {
              "lang": "en",
              "line": 3,
              "poem": "831",
              "start": 0,
              "text": "but words did not come easily to me."
            },
            {
              "lang": "en",
              "line": 4,
              "poem": "831",
              "start": 0,
              "text": "Whenever I quarrelled,"
            },
            {
              "lang": "en",
              "line": 5,
              "poem": "831",
              "start": 0,
              "text": "I would run out of words;"
            },
            {
              "lang": "en",
              "line": 6,
              "poem": "831",
              "start": 0,
              "text": "my fist would rise to the seventh heaven,"
            },
            {
              "lang": "en",
              "line": 7,
              "poem": "831",
              "start": 0,
              "text": "my tongue would falter,"
            },
            {
              "lang": "en",
              "line": 8,
              "poem": "831",
              "start": 0,
              "text": "and my hands would take over."
            },
            {
              "lang": "en",
              "line": 9,
              "poem": "831",
              "start": 0,
              "text": "Thus, in the innocence of youth,"
            },
            {
              "lang": "en",
              "line": 10,
              "poem": "831",
              "start": 0,
              "text": "violence would happen."
            }
          ],
          "overflow": 0,
          "titles": [
            {
              "lang": "en",
              "poem": "831",
              "title": "Gandhian Thought"
            }
          ]
        },
        {
          "horizontal": 0,
          "label": "Page 2 of 3",
          "lines": [
            {
              "lang": "en",
              "line": 11,
              "poem": "831",
              "start": 0,
              "text": "With age came understanding;"
            },
            {
              "lang": "en",
              "line": 12,
              "poem": "831",
              "start": 0,
              "text": "struggles came, and with them,"
            },
            {
              "lang": "en",
              "line": 13,
              "poem": "831",
              "start": 0,
              "text": "my nature began to change."
            },
            {
              "lang": "en",
              "line": 14,
              "poem": "831",
              "start": 0,
              "text": "Yet anger remained—"
            },
            {
              "lang": "en",
              "line": 15,
              "poem": "831",
              "start": 0,
              "text": "only its intensity diminished."
            },
            {
              "lang": "en",
              "line": 16,
              "poem": "831",
              "start": 0,
              "text": "Reading, reflection and contemplation grew."
            },
            {
              "lang": "en",
              "line": 17,
              "poem": "831",
              "start": 0,
              "text": "I read Gandhi,"
            },
            {
              "lang": "en",
              "line": 18,
              "poem": "831",
              "start": 0,
              "text": "and violence began to fade."
            },
            {
              "lang": "en",
              "line": 19,
              "poem": "831",
              "start": 0,
              "text": "I embraced the idea of non-violence."
            },
            {
              "lang": "en",
              "line": 20,
              "poem": "831",
              "start": 0,
              "text": "For a while,"
            },
            {
              "lang": "en",
              "line": 21,
              "poem": "831",
              "start": 0,
              "text": "violence and non-violence"
            },
            {
              "lang": "en",
              "line": 22,
              "poem": "831",
              "start": 0,
              "text": "walked side by side."
            },
            {
              "lang": "en",
              "line": 23,
              "poem": "831",
              "start": 0,
              "text": "Then age entered its forest,"
            },
            {
              "lang": "en",
              "line": 24,
              "poem": "831",
              "start": 0,
              "text": "and the mind became still water."
            }
          ],
          "overflow": 0,
          "titles": []
        }
      ]
    }
