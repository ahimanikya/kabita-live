  "entries": {
    "826": {
      "source_sha256": "59ec54a57356eba206084374f914ba5d60446ea2d7836604df7933af238c387c",
      "variants": {
        "en": {
          "label": "English",
          "title": "Devi Paksha",
          "kind": "Translation",
          "stanzas": [
            [
              "If one day, with the gentle breeze,",
              "a thunderbolt falls from the sky,",
              "and the earth gives way beneath your feet,",
              "before you can understand,",
              "they will overpower you—",
              "roaming beasts in human masks,",
              "more savage, more merciless",
              "than the animals of the forest.",
              "Four of them, from four sides,",
              "will tear at you, devour you.",
              "All your resistance,",
              "your heart-rending screams,",
              "will dissolve in the wind;",
              "the helpless earth will fall silent.",
              "You will lie lifeless, spent, naked,",
              "nothing but a lump of flesh.",
              "The moon will hide its face in the sky;",
              "the stars will put on an act.",
              "Before your breathing stops,",
              "there will not be a shred of strength",
              "to raise a hand, open your mouth and call.",
              "Beating his chest, the monster will go on raping,",
              "afraid of no one, of nothing.",
              "No god or goddess will come down;",
              "all those vows and fasts are only tales to soothe the mind."
            ]
          ],
          "credit": "AI-assisted translation.",
          "reader_layout": {
            "source_sha256": "59ec54a57356eba206084374f914ba5d60446ea2d7836604df7933af238c387c",
            "stanzas_sha256": "629837bb0492dd81323ada87bd3509a0e621de988d9007bc1b0fe1d47dbcc9b4",
            "verse_line_count": 25,
            "before_lines": [],
            "inline_breaks": []
          }
        },
        "hi": {
          "label": "हिन्दी",
          "title": "देवी पक्ष",
          "kind": "Translation",
          "stanzas": [
            [
              "अगर कभी मंद मलय पवन के साथ",
              "आकाश से वज्र गिरे,",
              "पाँवों के नीचे की धरती धँस जाए,",
              "तेरे कुछ समझ पाने से पहले",
              "तुझे दबोच लेंगे",
              "जंगल के पशुओं से भी",
              "अधिक हिंसक और निर्मम",
              "इंसानी मुखौटे वाले आवारा जानवर।",
              "चारों ओर से चार जन",
              "तुझे नोच-नोचकर खाएँगे।",
              "तेरा सारा प्रतिरोध,",
              "सीना चीरती चीखें",
              "हवा में खो जाएँगी;",
              "स्तब्ध रह जाएगी असहाय पृथ्वी।",
              "तेरा तन पड़ा रहेगा—निर्जीव, निढाल, निर्वस्त्र,",
              "बस मांस का एक लोथड़ा।",
              "आकाश में चाँद मुँह छिपा लेगा,",
              "तारे अभिनय करेंगे।",
              "साँस थमने से पहले",
              "हाथ उठाकर, मुँह खोलकर पुकारने की",
              "रत्ती भर ताकत भी नहीं होगी।",
              "छाती ठोकता राक्षस बलात्कार करता रहेगा,",
              "न किसी का डर, न भय।",
              "कोई देवी-देवता उतरकर नहीं आएँगे;",
              "सारे व्रत-उपवास बस मन बहलाने की कहानियाँ हैं।"
            ]
          ],
          "credit": "AI-assisted translation.",
          "reader_layout": {
            "source_sha256": "59ec54a57356eba206084374f914ba5d60446ea2d7836604df7933af238c387c",
            "stanzas_sha256": "0058daf351a3d4ceaba0d1758add217de5b1f9413eec0fd3be6120ed72dd3bfe",
