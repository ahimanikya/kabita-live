    "829": {
      "source_sha256": "ed4c901ba8fc21ac64afe1d80046605251e386329c326efe44fe56ef9142091d",
      "variants": {
        "en": {
          "label": "English",
          "title": "The Cry of Silence",
          "kind": "Translation",
          "stanzas": [
            [
              "From now on I will bind myself",
              "to silence, a bond that will not break.",
              "I will give up the spell",
              "of countless expectations",
              "and still my lips.",
              "Like desert sand holding",
              "innumerable footprints to its breast,",
              "like the foot-scrubbing stone at the river steps,",
              "I will lie there, unceasingly;",
              "like the village pond",
              "hiding unfathomable depths",
              "within itself,",
              "like a heart that swallows",
              "billow after billow of smoke",
              "and beats quietly, unable to speak...",
              "I will fall utterly silent.",
              "What difference does it make to anyone",
              "if I say nothing?",
              "No gentle breeze stops",
              "beyond someone’s window,",
              "no moonlight fades",
              "in someone’s sky;",
              "the cycle of seasons does not change,",
              "no one’s days and nights",
              "are emptied of people.",
              "My silence",
              "wounds no one,",
              "burns no one’s heart.",
              "Only, drop by drop, feeling",
              "collects in the hollows beneath my eyes,",
              "settles and darkens—",
              "no one hears",
              "the ceaseless clamour of pain",
              "inside my silence."
            ]
          ],
          "credit": "AI-assisted translation.",
          "reader_layout": {
            "source_sha256": "ed4c901ba8fc21ac64afe1d80046605251e386329c326efe44fe56ef9142091d",
            "stanzas_sha256": "0ae79212142766563474249760ebc233eef5f955758db66fc764482743b3674c",
            "verse_line_count": 34,
            "before_lines": [],
            "inline_breaks": []
          }
        },
        "hi": {
          "label": "हिन्दी",
          "title": "नीरवता का आर्तनाद",
          "kind": "Translation",
          "stanzas": [
            [
              "अब से नीरवता के साथ",
              "एक अटूट नाता बाँध लेना है,",
              "अनगिनत अपेक्षाओं का",
              "सारा मोह त्यागकर",
              "होंठों को मौन कर देना है।",
              "अनगिनत पदचिह्न सीने में",
              "दबाए हुए मरु की रेत की तरह,",
              "नदी के घाट पर पैर घिसने के पत्थर की तरह",
              "बस पड़े रहना है;",
              "अपने भीतर",
              "अथाह गहराई छिपाए",
              "गाँव के पोखर की तरह,",
              "धुएँ के गुबार पर गुबार पीकर",
              "चुपचाप धड़कते",
              "एक अव्यक्त हृदय की तरह...",
              "मुझे बिल्कुल चुप हो जाना है।",
              "किसे क्या फर्क पड़ता है",
              "मेरे चुप रहने से?",
              "न किसी की खिड़की के उस पार",
              "मलय पवन का बहना रुकता है,",
              "न किसी के आकाश में",
              "चाँदनी कम होती है;",
              "न ऋतुचक्र बदलता है,",
              "न किसी के दिन-रात",
              "लोगों से खाली हो जाते हैं।",
              "मेरी नीरवता",
              "किसी को चोट नहीं देती,",
              "किसी का हृदय नहीं जलाती।",
              "बस बूँद-बूँद आवेग",
              "आँखों के नीचे के गड्ढों में",
              "जमकर काला पड़ जाता है—",
              "किसी को सुनाई नहीं देता",
              "मेरे मौन में अनवरत गूँजता",
              "पीड़ा का कोलाहल।"
            ]
          ],
          "credit": "AI-assisted translation.",
          "reader_layout": {
            "source_sha256": "ed4c901ba8fc21ac64afe1d80046605251e386329c326efe44fe56ef9142091d",
            "stanzas_sha256": "56c66d16dab48bd99219e08ecd8e6c2e279c3fdcb758b5126439b3d26e49a5db",
            "verse_line_count": 34,
