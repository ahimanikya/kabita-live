    "824": {
      "source_sha256": "90477b194cfcc6f7575f1c97d9bf518b2318846eec350e799aa83b4eb344a8bf",
      "variants": {
        "hi": {
          "label": "हिन्दी",
          "title": "अब प्रेम कविताएँ नहीं",
          "kind": "Translation",
          "stanzas": [
            [
              "अब प्रेम कविताएँ नहीं,",
              "न उन्हें लिखना है,",
              "न आगे कभी प्रेम कविताएँ पढ़नी हैं।"
            ],
            [
              "पर मेरे लिए यह आसान नहीं,",
