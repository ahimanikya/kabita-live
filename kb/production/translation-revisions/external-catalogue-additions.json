    },
    "833": {
      "source_sha256": "02a4b74787ecb68e418aef0c247991c8f069a4c0503221cfbc3f1deffd4cf64d",
      "variants": {
        "en": {
          "label": "English",
          "title": "The Wager",
          "kind": "Translation",
          "stanzas": [
            [
              "I touch my eyes...",
              "I swear it is true...",
              "With you as witness",
              "I laid my wager—",
              "gave over",
              "my unalloyed trust...",
              "spread out my longing",
              "and my trembling span of life...",
              "cast away",
              "the throne of my dreams,",
              "poured out",
              "my tears, sweat and sighs—"
            ],
            [
              "After all those moments had passed,",
              "I came to know:",
              "there is nothing to gain here",
              "except to lose one’s head for nothing—",
              "fate and all that",
              "lead to no shore...",
              "this crooked-straight business of living,",
              "this tangle of poison and nectar,",
              "are of no use—",
              "the colours of the rainbow",
              "and another’s support",
              "serve no purpose...",
              "all of it is only swimming through mist,",
              "all those false arts",
              "of building a stairway to the sky—",
              "looking and looking,",
              "reckoning and reckoning,",
              "the day went under...",
              "counting stars in daylight",
              "still remained to be done—"
            ],
            [
              "Now the intoxication has passed...",
              "O fool!",
              "Is gambling",
              "punishment or addiction?...",
              "Now I have tested it:",
              "the pleasure of the wager",
              "lies in losing...",
              "to lose at the gamble of life",
              "is the greatest bargain of all—"
            ]
          ],
          "credit": "AI-assisted translation.",
          "reader_layout": {
            "source_sha256": "02a4b74787ecb68e418aef0c247991c8f069a4c0503221cfbc3f1deffd4cf64d",
            "stanzas_sha256": "b73abea2edddf806557a2dd9671ebeb3308801fe0d3c0fa113bee805a7e6e01e",
            "verse_line_count": 41,
            "before_lines": [
              12,
              32
            ],
            "inline_breaks": []
          }
        },
        "hi": {
          "label": "हिन्दी",
          "title": "जुआ",
          "kind": "Translation",
          "stanzas": [
            [
              "आँखों को छूकर...",
              "सच कहूँ...",
              "तुम्हें साक्षी रखकर",
              "बाज़ी लगा दी—",
              "सौंप दिया",
              "अपना निर्मल विश्वास...",
              "बिछा दीं अपनी आकांक्षाएँ",
              "और थरथराती उम्र...",
              "फेंक दिया",
              "अपने सपनों का सिंहासन,",
              "उँडेल दिए",
              "आँसू, पसीना, लंबी साँसें—"
            ],
            [
              "सारे पल बीत जाने पर",
              "समझ आया,",
              "यहाँ बेवजह बावरा होने के सिवा",
              "और कोई लाभ नहीं—",
              "भाग्य-वाग्य",
              "किसी किनारे नहीं पहुँचाता...",
              "यह टेढ़ा-सीधा संसारपन,",
              "विष-अमृत का जंजाल,",
              "किसी काम का नहीं—",
              "न किसी काम के हैं",
              "इंद्रधनुष के रंग",
              "और दूसरों का सहारा...",
              "सब बस कुहरे में तैरना है,",
              "आकाश तक सीढ़ी लगाने की",
              "झूठी कलाएँ—",
              "देखते-परखते,",
              "हिसाब करते-करते",
              "दिन डूब गया...",
              "दिन में तारे गिनना",
              "अब भी बाकी रह गया—"
            ],
            [
              "अब नशा उतर गया है...",
              "अरे बावरे!",
              "जुआ खेलना",
              "सज़ा है या नशा?...",
              "अब परख लिया,",
              "जुए में हारने में ही",
              "मज़ा है...",
              "ज़िंदगी के जुए में हार जाना ही",
              "सबसे बड़ा सौदा है—"
            ]
          ],
          "credit": "AI-assisted translation.",
          "reader_layout": {
            "source_sha256": "02a4b74787ecb68e418aef0c247991c8f069a4c0503221cfbc3f1deffd4cf64d",
